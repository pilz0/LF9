# Environment Configuration Template for LF9 Project
# Copy this file to .env and adjust the values as needed

# Database Passwords
MARIADB_PASSWORD=your_secure_password_here
POSTGRES_PASSWORD=your_secure_postgres_password

# FTP Server Configuration
FTP_PASSWORD=your_secure_ftp_password

# Samba/SMB Configuration  
SMB_PASSWORD=your_secure_smb_password

# WikiJS Configuration
WIKIJS_DB_PASSWORD=your_secure_wiki_password

# VNC Configuration
VNC_PASSWORD=your_secure_vnc_password

# Network Configuration
NETWORK_SUBNET_IPV4=10.13.12.0/24
NETWORK_SUBNET_IPV6=fd69:acab:1312::/64

# Service Versions (update as needed)
MARIADB_VERSION=11.4
WORDPRESS_VERSION=6
GRAFANA_VERSION=latest
PROMETHEUS_VERSION=latest
POSTGRES_VERSION=15-alpine